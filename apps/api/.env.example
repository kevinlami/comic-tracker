# URL de conexão com o PostgreSQL (local)
DATABASE_URL="postgresql://user:password@localhost:5432/comic_tracker?schema=public"

# Porta do servidor da API
PORT=3000

# Origens permitidas pelo CORS, separadas por vírgula.
# Ex.: frontend em desenvolvimento (Next.js na porta 3001).
# Se vazio ou ausente, o CORS fica desabilitado.
CORS_ORIGINS="http://localhost:3001"
